#!/usr/bin/env sh
# runtime/evm-hardhat 的原生链能力插件,复用镜像内固定版本 cast 连接 Anvil。
set -eu

action="${1:-}"
: "${CHAIMIR_CHAIN_RPC_URL:?CHAIMIR_CHAIN_RPC_URL is required}"
: "${CHAIMIR_CHAIN_STATE_DIR:?CHAIMIR_CHAIN_STATE_DIR is required}"
: "${FOUNDRY_TRANSACTION_TIMEOUT:?FOUNDRY_TRANSACTION_TIMEOUT is required}"
rpc_url="$CHAIMIR_CHAIN_RPC_URL"
state_dir="$CHAIMIR_CHAIN_STATE_DIR"
last_contract_file="$state_dir/last-contract-address"
fail() { printf '%s\n' "$1" >&2; exit "${2:-1}"; }
case "$FOUNDRY_TRANSACTION_TIMEOUT" in
  ''|*[!0-9]*) fail "FOUNDRY_TRANSACTION_TIMEOUT must be a positive integer" 22 ;;
esac
[ "$FOUNDRY_TRANSACTION_TIMEOUT" -gt 0 ] || fail "FOUNDRY_TRANSACTION_TIMEOUT must be positive" 22
payload="$(cat)"; [ -n "$payload" ] || payload='{}'
payload="$(printf '%s' "$payload" | jq -ces 'if length == 1 and (.[0] | type == "object") then .[0] else error("expected one action payload") end')" || fail "输入必须是单份 JSON 对象" 22

json_string() {
  jq -r "$1 | if . == null then empty elif type == \"string\" then . else error(\"expected string\") end"
}

require_receipt() {
  jq -ces 'if length == 1 then .[0] |
    if type == "object" and .status == "0x1" and (.transactionHash | type == "string" and test("^0x[0-9a-fA-F]{64}$"))
    then . else error("unexpected transaction receipt") end
    else error("expected one transaction receipt") end' || fail "交易执行状态或回执无效" 70
}

first_account() { cast rpc --rpc-url "$rpc_url" eth_accounts | jq -r '.[0] // empty'; }
case "$action" in
  deploy)
    bytecode="$(printf '%s' "$payload" | json_string '.bytecode')"; [ -n "$bytecode" ] || { echo 'deploy payload requires bytecode' >&2; exit 22; }
    from="$(printf '%s' "$payload" | json_string '.from')"; [ -n "$from" ] || from="$(first_account)"; [ -n "$from" ] || { echo 'node has no deployer account' >&2; exit 70; }
    receipt="$(cast send --rpc-url "$rpc_url" --from "$from" --unlocked --timeout "$FOUNDRY_TRANSACTION_TIMEOUT" --create "$bytecode" --json)"
    receipt="$(printf '%s' "$receipt" | require_receipt)"
    address="$(printf '%s' "$receipt" | jq -er '.contractAddress | select(type == "string" and test("^0x[0-9a-fA-F]{40}$") and . != "0x0000000000000000000000000000000000000000")')" || fail "deploy did not return a valid contract address" 70
    mkdir -p "$state_dir"; printf '%s' "$address" > "$last_contract_file"
    jq -cn --arg contract_address "$address" --argjson receipt "$receipt" '{contract_address:$contract_address,receipt:$receipt}'
    ;;
  tx)
    if printf '%s' "$payload" | jq -e 'has("raw_transaction")' >/dev/null; then
      raw_transaction="$(printf '%s' "$payload" | jq -er 'if keys == ["raw_transaction"] and (.raw_transaction | type == "string" and test("^0x([0-9a-fA-F]{2})+$")) then .raw_transaction else error("invalid signed transaction payload") end')" || fail "raw_transaction must be the only field and contain non-empty hex bytes" 22
      receipt="$(timeout --signal=KILL "$FOUNDRY_TRANSACTION_TIMEOUT" cast publish --rpc-url "$rpc_url" --json "$raw_transaction")"
      receipt="$(printf '%s' "$receipt" | require_receipt)"
      jq -cn --argjson receipt "$receipt" '{receipt:$receipt}'
      exit 0
    fi
    to="$(printf '%s' "$payload" | json_string '.to')"; if [ -z "$to" ] && [ -f "$last_contract_file" ]; then to="$(cat "$last_contract_file")"; fi
    data="$(printf '%s' "$payload" | json_string '.data')"; [ -n "$to" ] && [ -n "$data" ] || { echo 'tx payload requires to and data' >&2; exit 22; }
    from="$(printf '%s' "$payload" | json_string '.from')"
    value="$(printf '%s' "$payload" | jq -r '.value | if . == null then empty elif type == "string" then . elif type == "number" and . >= 0 and floor == . then tostring else error("expected unsigned quantity") end')"
    [ -n "$from" ] || from="$(first_account)"
    [ -n "$from" ] || fail "node has no transaction account" 70
    set -- cast send --rpc-url "$rpc_url" --from "$from" --unlocked --timeout "$FOUNDRY_TRANSACTION_TIMEOUT" --json
    if [ -n "$value" ]; then set -- "$@" --value "$value"; fi
    receipt="$("$@" "$to" "$data")"
    receipt="$(printf '%s' "$receipt" | require_receipt)"
    jq -cn --argjson receipt "$receipt" '{receipt:$receipt}'
    ;;
  query)
    target="$(printf '%s' "$payload" | json_string '.target')"; [ -n "$target" ] || { echo 'query target is required' >&2; exit 22; }
    case "$target" in
      chainId) value="$(cast chain-id --rpc-url "$rpc_url")"; jq -cn --arg target "$target" --arg value "$value" '{target:$target,chain_id:$value}' ;;
      latest|blockNumber) value="$(cast block-number --rpc-url "$rpc_url")"; jq -cn --arg target "$target" --arg value "$value" '{target:$target,block_number:$value}' ;;
      balance:*) address="${target#balance:}"; value="$(cast balance --rpc-url "$rpc_url" "$address")"; jq -cn --arg target "$target" --arg value "$value" '{target:$target,balance:$value}' ;;
      code:*) address="${target#code:}"; value="$(cast code --rpc-url "$rpc_url" "$address")"; jq -cn --arg target "$target" --arg value "$value" '{target:$target,code:$value}' ;;
      *) echo 'unsupported query target' >&2; exit 22 ;;
    esac
    ;;
  *) echo 'unknown chain action' >&2; exit 64 ;;
esac
