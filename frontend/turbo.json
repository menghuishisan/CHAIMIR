{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": [
        "VITE_API_BASE_URL",
        "VITE_WS_BASE_URL",
        "VITE_API_TIMEOUT_MS",
        "VITE_RUNTIME_SELFTEST_POLL_INTERVAL_MS",
        "VITE_RUNTIME_SELFTEST_POLL_TIMEOUT_MS",
        "VITE_SIM_WORKER_COMMAND_TIMEOUT_MS",
        "VITE_SIM_STEP_INTERVAL_MS"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "type-check": {
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}
