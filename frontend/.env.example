# 前端构建期环境变量示例。
# 后端统一 API 根地址，生产环境由部署层注入。
VITE_API_BASE_URL=/api/v1
# 可选：独立 WebSocket 根地址；默认由 API 地址推导。
VITE_WS_BASE_URL=
# 部署形态与沙箱工具 origin 由 deploy/config/chaimir.env 经初始化容器生成 /runtime-config.js,
# 不写入静态镜像,以保证 SaaS 与学校私有化共用同一前端 digest 和配置来源。
# 前端 API 请求超时时间。
VITE_API_TIMEOUT_MS=30000
# 该值由具体前端应用在装配层读取后,传入 sim-sdk 的 workerCommandTimeoutMs。
VITE_SIM_WORKER_COMMAND_TIMEOUT_MS=2000
# 仿真自动推进的教学基准节奏(1 倍速单步间隔,毫秒);变速档在此基础上按倍数缩放。
VITE_SIM_STEP_INTERVAL_MS=1200
