{
  "name": "@chaimir/frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Chaimir 区块链教学平台前端",
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:frontend-standards": "node ../scripts/audit/check-frontend-standards.mjs",
    "audit:repo": "node ../scripts/audit/index.mjs",
    "type-check": "turbo run type-check",
    "clean:artifacts": "rimraf --glob .turbo apps/*/.turbo apps/*/dist packages/*/.turbo packages/*/dist",
    "clean:deps": "node -e \"const fs=require('node:fs');const path=require('node:path');for(const root of ['apps','packages'])if(fs.existsSync(root))for(const name of fs.readdirSync(root))fs.rmSync(path.join(root,name,'node_modules'),{recursive:true,force:true});fs.rmSync('node_modules',{recursive:true,force:true});\"",
    "clean": "pnpm clean:artifacts && pnpm clean:deps"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.34.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "prettier": "^3.3.2",
    "rimraf": "^6.1.3",
    "turbo": "^2.0.4",
    "typescript": "^5.4.5"
  },
  "packageManager": "pnpm@9.1.0",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "pnpm": ">=9.0.0"
  },
  "dependencies": {
    "@chaimir/api-client": "workspace:*",
    "@chaimir/ui": "workspace:*"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@<1.1.18": "1.1.18",
      "brace-expansion@>=2.0.0 <2.1.4": "2.1.4"
    }
  }
}
