# ============================================================================
# Chaimir 平台密钥环境变量模板(占位)。真实值绝不入仓库。
# ----------------------------------------------------------------------------
# 铁律(CLAUDE.md §6/§7):密钥走 K8s Secret/KMS,不入代码/镜像/仓库。
# 用法:
#   · 本文件登记私有化/验收密钥源字段契约,复制后的 secret.env 被 .gitignore 忽略。
#   · 部署过程不把本文件直接注入 Pod;运维脚本仅用它更新受 RBAC 保护的源 Secret,再由 ExternalSecret 按字段同步。
# 每个变量都带注释说明用途。
#
# PowerShell 生成命令(兼容 Windows PowerShell 5.1;只输出随机值,不写文件;复制输出后填到对应变量):
#   $rng=[System.Security.Cryptography.RandomNumberGenerator]::Create(); $bytes=New-Object byte[] 32; $rng.GetBytes($bytes); -join ($bytes | ForEach-Object { $_.ToString('x2') })
# 16 字节十六进制值:
#   $rng=[System.Security.Cryptography.RandomNumberGenerator]::Create(); $bytes=New-Object byte[] 16; $rng.GetBytes($bytes); -join ($bytes | ForEach-Object { $_.ToString('x2') })
# 32 字节 Base64 值(APP_ENCRYPTION_KEY 专用,AES-256-GCM 要求解码后正好 32 字节):
#   $rng=[System.Security.Cryptography.RandomNumberGenerator]::Create(); $bytes=New-Object byte[] 32; $rng.GetBytes($bytes); [Convert]::ToBase64String($bytes)
# 符合本项目密码强度的随机初始密码(含字母和数字):
#   "Chaimir-" + (-join ((48..57 + 65..90 + 97..122) | Get-Random -Count 24 | ForEach-Object {[char]$_})) + "1"
# ============================================================================

# JWT 签名密钥(会话令牌签名;生产建议非对称私钥 PEM)。
# 生成:使用上方 32 字节十六进制值命令。
JWT_SIGNING_KEY=changeme-jwt-signing-key
OP_GETH_JWT_SECRET=changeme-op-geth-jwt-secret
# 应用层敏感字段加密密钥(落库前加密)。
# 生成:使用上方 32 字节 Base64 值命令。
APP_ENCRYPTION_KEY=changeme-encryption-key-base64-32b
# 应用层 HMAC 密钥(手机号、验证码、Refresh Token 等可查询哈希)。
# 生成:使用上方 32 字节十六进制值命令。
APP_HMAC_KEY=changeme-hmac-key
# 成绩单 PDF/导出件签名密钥;用于验证成绩文件未被篡改。
# 生成:使用上方 32 字节十六进制值命令。
GRADE_TRANSCRIPT_SIGNING_KEY=changeme-grade-transcript-signing-key
# PostgreSQL 密码(与 chaimir.env 的 PG_USER/PG_DATABASE 配套)。
# 生成:使用上方 32 字节十六进制值命令。
PG_PASSWORD=changeme-pg-password
# The Graph proof-of-indexing 路由令牌;只注入 infra/thegraph-node。
# 使用上方 32 字节十六进制值生成命令生成。
GRAPH_POI_ACCESS_TOKEN=changeme-graph-poi-access-token
# Chainlink 运行期 keystore 加密口令(只注入 Chainlink 沙箱节点)。
CHAINLINK_KEYSTORE_PASSWORD=changeme-chainlink-keystore-password
# Chainlink 首次启动 API 登录邮箱(只注入 Chainlink 沙箱节点)。
CHAINLINK_API_EMAIL=chainlink-admin@example.invalid
# Chainlink 首次启动 API 登录密码(只注入 Chainlink 沙箱节点)。
CHAINLINK_API_PASSWORD=changeme-chainlink-api-password
# Chainlink 节点 HTTPS 证书和私钥的 Base64 值;由平台 Secret/KMS 注入,不得写入镜像或 CompositionSpec。
CHAINLINK_TLS_CERT_B64=changeme-chainlink-tls-cert-b64
CHAINLINK_TLS_KEY_B64=changeme-chainlink-tls-key-b64
# PostgreSQL 特权用户名;仅中间件初始化、迁移和登录前受控跨租户查询使用。
PG_PRIV_USER=postgres
# PostgreSQL 特权用户密码;仅中间件初始化、迁移和受控特权路径使用。
# 生成:使用上方 32 字节十六进制值命令。
PG_PRIV_PASSWORD=changeme-pg-owner-password
# Redis 访问密码(生产必设)。
# 生成:使用上方 32 字节十六进制值命令。
REDIS_PASSWORD=changeme-redis-password
# S3 对象存储 访问密钥(access key)。
# 生成:使用上方 16 字节十六进制值命令,或使用运维分配的可读 access key。
OBJECT_STORAGE_ACCESS_KEY=changeme-rustfs-access
# S3 对象存储 秘密密钥(secret key)。
# 生成:使用上方 32 字节十六进制值命令。
OBJECT_STORAGE_SECRET_KEY=changeme-rustfs-secret
# IPFS Cluster 官方 CRDT cluster.secret;由平台 Secret/KMS 注入,不得写入镜像或 CompositionSpec。
CHAIMIR_IPFS_CLUSTER_SECRET=changeme-ipfs-cluster-secret
# Hyperlane relayer 默认签名私钥;只注入对应沙箱的中继器,由平台 Secret/KMS 管理。
HYP_DEFAULTSIGNER_KEY=changeme-hyperlane-signer-private-key
# NATS 连接 token(生产必设)。
# 生成:使用上方 32 字节十六进制值命令。
NATS_TOKEN=changeme-nats-token
# CouchDB 富查询管理员用户名;仅注入 Fabric 富查询 CouchDB 容器。
COUCHDB_USER=chaimir-couchdb-admin
# CouchDB 富查询管理员密码;必须由 Secret/KMS 运行期注入。
COUCHDB_PASSWORD=changeme-couchdb-password
# HTTP 短信代理网关 Bearer Token(SMS_PROVIDER=http 时生产必设)。
# 生成:使用上方 32 字节十六进制值命令;若接入真实短信代理,以代理网关签发值为准。
SMS_HTTP_TOKEN=changeme-sms-token
# 私有化首个学校管理员手机号;初始化时服务端加密与哈希入库。
BOOTSTRAP_ADMIN_PHONE=13800138000
# 私有化首个学校管理员姓名;与手机号一起作为首个高权限账号开通资料。
BOOTSTRAP_ADMIN_NAME=首个管理员
# 私有化首个学校管理员初始密码;只供 migrate-and-seed 首次创建账号,首登后强制修改。
# 生成:使用上方随机初始密码命令。
BOOTSTRAP_ADMIN_PASSWORD=changeme-bootstrap-admin-password
# SaaS 首个平台管理员登录名;只供 migrate-and-seed 首次创建账号,不得入 ConfigMap。
BOOTSTRAP_PLATFORM_ADMIN_USERNAME=platform-admin
# SaaS 首个平台管理员显示名;非敏感展示配置仍由 chaimir.env 提供。
# 该值不属于密钥源,仅用于平台管理员显示名。
# SaaS 首个平台管理员初始密码;只供 migrate-and-seed 首次创建账号,不得入 ConfigMap。
# 生成:使用上方随机初始密码命令。
BOOTSTRAP_PLATFORM_ADMIN_PASSWORD=changeme-platform-admin-password
# DApp 钱包教学服务 HMAC 鉴权密钥;调用方必须按请求签名。
# 生成:使用上方 32 字节十六进制值命令。
CHAIMIR_WALLET_SESSION_SECRET=changeme-wallet-session-secret
# 账户抽象 Paymaster 签名私钥;仅注入对应沙箱内 infra 容器。
# 生成:使用上方 32 字节十六进制值命令。
CHAIMIR_PAYMASTER_PRIVATE_KEY=changeme-paymaster-private-key
# 账户抽象 Paymaster HMAC 鉴权密钥;调用方必须按请求签名。
# 生成:使用上方 32 字节十六进制值命令。
CHAIMIR_PAYMASTER_SERVICE_AUTH_SECRET=changeme-paymaster-service-auth-secret
# 事件监听服务 HMAC 鉴权密钥;调用方必须按请求签名。
# 生成:使用上方 32 字节十六进制值命令。
CHAIMIR_EVENT_LISTENER_SERVICE_AUTH_SECRET=changeme-event-listener-service-auth-secret
# Foundry 运行时账户 mnemonic;Anvil 与平台工具从同一受控材料派生账户。
# 生产环境必须替换为平台 Secret/KMS 中的专用 mnemonic。
CHAIMIR_EVM_DEPLOYER_MNEMONIC=changeme-evm-deployer-mnemonic
CHAIMIR_EVM_DEPLOYER_PRIVATE_KEY=changeme-evm-deployer-private-key
# Blockscout 会话与内部签名基密钥;仅注入对应沙箱内浏览器组件。
# 生成:使用上方 32 字节十六进制值命令。
SECRET_KEY_BASE=changeme-blockscout-secret-key-base
